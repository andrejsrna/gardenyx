{
  "name": "gardenyx-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "NODE_ENV=production next build",
    "postbuild": "echo \"[postbuild] Build finished at $(date -u '+%Y-%m-%dT%H:%M:%SZ')\"",
    "migrate:deploy": "prisma migrate deploy",
    "start": "npm run migrate:deploy && NODE_ENV=production next start",
    "lint": "eslint . --max-warnings=0",
    "test:pricing": "ts-node --compiler-options '{\"allowImportingTsExtensions\":true}' scripts/test-pricing.ts",
    "test:stripe-meta": "ts-node --compiler-options '{\"allowImportingTsExtensions\":true}' scripts/test-stripe-metadata-consistency.ts",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test tests/e2e/checkout-mocked.spec.ts",
    "test:e2e:real": "E2E_REAL=1 playwright test tests/e2e/checkout-real.spec.ts",
    "test:order-flow": "ts-node --compiler-options '{\"allowImportingTsExtensions\":true}' scripts/e2e-order-flow.ts",
    "migrate:products": "node scripts/migrate-products-to-db.mjs",
    "post:facebook": "node scripts/post-to-facebook.mjs",
    "export:wp-posts": "echo \"Deprecated: WordPress export removed\"",
    "export:woo-products": "echo \"Deprecated: WooCommerce export removed\"",
    "import:woo-orders": "echo \"Deprecated: WooCommerce import removed\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@getbrevo/brevo": "^3.0.4",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/xml2js": "^0.4.14",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookies-next": "^6.1.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "iron-session": "^9.0.1",
    "isomorphic-dompurify": "^3.0.0",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "next-intl": "^4.9.0",
    "pg": "^8.23.0",
    "prisma": "7.10.1",
    "react": "^19.3.0",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tiptap-markdown": "^0.9.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "mdast-util-to-hast": "13.2.1",
    "tar": "^7.5.2",
    "hono": "^4.12.7",
    "@hono/node-server": "^1.19.10",
    "lodash": "^4.18.1",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
